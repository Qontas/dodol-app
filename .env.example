APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

# Docker/Railway production only; artisan serve and tests are unchanged.
# Raise via Railway Variables + redeploy/restart, no code change required.
# FRANKENPHP_THREADS = total PHP threads (not extra threads); MUST exceed OCTANE_WORKERS.
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500
FRANKENPHP_THREADS=8

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cemilan_qontas_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk media (foto kios). Lokal default; set 's3' saat R2/S3 siap (foto persist di Railway).
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (Cloudflare R2 / S3). Isi saat siap, lalu set MEDIA_DISK=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# R2: endpoint akun (https://<account_id>.r2.cloudflarestorage.com) + public URL bucket.
AWS_ENDPOINT=
AWS_URL=

VITE_APP_NAME="${APP_NAME}"

# Jam idle minimal sebelum trip "lupa diakhiri" ditutup otomatis (lihat
# App\Support\TripAutoCloser & config/trips.php). Default 6.
TRIP_AUTO_CLOSE_IDLE_HOURS=6

# Pencatat request lambat (config/performance.php). Baris log berawalan SLOW_REQUEST
# ke stderr (terlihat di tab Logs Railway). Ambang bisa diubah tanpa deploy kode.
SLOW_REQUEST_ENABLED=true
SLOW_REQUEST_MS=800
SLOW_REQUEST_QUERIES=40
SLOW_REQUEST_LOG_CHANNEL=stderr
SERVER_TIMING_ENABLED=true

# Rapor kedai: ambang analisis (saran saja, tidak mengubah data bisnis).
KIOSK_INSIGHTS_MIN_SETTLEMENTS=3
KIOSK_INSIGHTS_SLOW_PCT=60
KIOSK_INSIGHTS_FAST_PCT=80
KIOSK_INSIGHTS_FAST_PERCENTILE=75
# Kedaluwarsa/rusak saja, BUKAN retur segar.
KIOSK_INSIGHTS_BS_PCT=10
KIOSK_INSIGHTS_DEBT_DAYS=30
KIOSK_INSIGHTS_INACTIVE_DAYS=30
KIOSK_INSIGHTS_REVISIT_DAYS=14
KIOSK_INSIGHTS_TIMEZONE=Asia/Jakarta
KIOSK_INSIGHTS_REVISIT_MIN_DAYS=10
KIOSK_INSIGHTS_REVISIT_GAP_MULTIPLIER=1.5
KIOSK_INSIGHTS_REVISIT_MIN_GAPS=3
KIOSK_INSIGHTS_MAX_QUOTA_INCREASE=2
# Foto export: deadline internal maks 8.5 detik + headroom request/state IO (~10 detik).
# Nilai berlebih dijepit; per gelombang maks 10 foto, sumber maks 5 MB / 4 MP.
KIOSK_INSIGHTS_PHOTO_BUDGET=8.5
KIOSK_INSIGHTS_PHOTO_CONCURRENCY=10
KIOSK_INSIGHTS_PHOTO_CONNECT_TIMEOUT=1
KIOSK_INSIGHTS_PHOTO_THUMB_TIMEOUT=1.5
KIOSK_INSIGHTS_PHOTO_SOURCE_TIMEOUT=3
KIOSK_INSIGHTS_PHOTO_PUT_TIMEOUT=1
KIOSK_INSIGHTS_PHOTO_MAX_BYTES=5242880

# Cache alamat Maps: command kiosks:fill-maps-address (default dry-run) dan tahap awal export Laporan Kedai
# (maks 6 kedai per tick, 60 per export; dilewati bila kontak/key kosong). Request web lain tidak memanggil provider.
# Nominatim memerlukan kontak layanan PUBLIK yang disetujui untuk dikirim keluar.
# Kosong = command menolak request Nominatim; jangan gunakan email pribadi/billing.
# Kosong = otomatis Google bila GOOGLE_MAPS_API_KEY terisi, selain itu Nominatim.
REVERSE_GEOCODING_PROVIDER=
REVERSE_GEOCODING_USER_AGENT="KioskAddressBackfill/1.0"
REVERSE_GEOCODING_CONTACT_EMAIL=
# Alternatif berbayar: cukup isi API key Geocoding khusus server ini.
GOOGLE_MAPS_API_KEY=
